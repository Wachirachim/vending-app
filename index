function drawCover(ctx,img,x,y,w,h){
  const a=img.width/img.height,ta=w/h;let sx=0,sy=0,sw=img.width,sh=img.height;
  if(a>ta){sw=img.height*ta;sx=(img.width-sw)/2}else{sh=img.width/ta;sy=(img.height-sh)/2}
  ctx.drawImage(img,sx,sy,sw,sh,x,y,w,h);
}


function drawContain(ctx,img,x,y,w,h){
  const a=img.width/img.height,ta=w/h;
  let dw=w,dh=h,dx=x,dy=y;
  if(a>ta){
    dh=w/a;
    dy=y+(h-dh)/2;
  } else {
    dw=h*a;
    dx=x+(w-dw)/2;
  }
  ctx.drawImage(img,dx,dy,dw,dh);
}


function drawImageFit(ctx,img,x,y,w,h,mode){
  if(mode === 'contain'){
    drawContain(ctx,img,x,y,w,h);
  } else {
    drawCover(ctx,img,x,y,w,h);
  }
}


