// ----- Helper -----
function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}


// โหลดรูปจากไฟล์ (คืน Promise) ใช้ร่วมกันทุกแท็บ เพื่อให้ลำดับรูปตรงกับที่เลือก
function loadImageFile(file){
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => resolve(img);
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('โหลดรูปไม่ได้: ' + file.name)); };
    img.src = url;
  });
}
function releaseImage(img){
  try { if(img && img.src && img.src.startsWith('blob:')) URL.revokeObjectURL(img.src); } catch(e){}
}


// รอให้ฟอนต์โหลดเสร็จก่อนวาดตัวอักษรลงรูป (กันตัวหนังสือเป็นฟอนต์สำรองในการกดครั้งแรก)
async function ensureFonts(){
  try {
    if(!document.fonts || !document.fonts.load) return;
    await Promise.race([
      Promise.all([
        document.fonts.load('700 50px "Prompt"', 'ก1Aa'),
        document.fonts.load('700 50px "Sarabun"', 'ก1Aa')
