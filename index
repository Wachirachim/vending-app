let ytSupportPlayer = null, isPlaying = false;
function onYouTubeIframeAPIReady(){
  try {
    ytSupportPlayer = new YT.Player('ytPlayerBox', {
      events: {
        'onReady': (e) => { try { e.target.setLoop(true); } catch(err){} },
        'onStateChange': (e) => {
          const btn = document.getElementById('btnPlayPause');
          if(e.data === YT.PlayerState.PLAYING){
            isPlaying = true;
            btn.innerHTML = '⏸️ หยุดเพลง';
          } else if(e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.ENDED){
            isPlaying = false;
            btn.innerHTML = '▶️ เล่นเพลง';
          }
        }
      }
    });
  } catch(e){}
}
function togglePlayMusic(){
  if(!ytSupportPlayer) return;
  try {
    if(isPlaying){ ytSupportPlayer.pauseVideo(); }
    else { ytSupportPlayer.playVideo(); }
  } catch(e){}
}
function toggleMuteMusic(){
  if(!ytSupportPlayer) return;
  try {
    const btn = document.getElementById('btnMuteUnmute');
    if(ytSupportPlayer.isMuted()){
      ytSupportPlayer.unMute();
      btn.innerHTML = '🔇 ปิดเสียง';
