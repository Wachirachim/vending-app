const BACKUP_KEY = 'backup_to_drive';
function isBackupOn(){
  try { return localStorage.getItem(BACKUP_KEY) !== 'off'; } catch(e){ return true; }
}
function saveBackupPref(){
  const on = document.getElementById('chkBackup').checked;
