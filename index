// ================== บันทึกรูป + สำรองลง Google Drive ==================
async function backupToDrive(canvas, folderName, fileName){
  try{
    const res = await fetch(GAS_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' }, // text/plain ป้องกันติด CORS preflight
      body: JSON.stringify({
        folderName: folderName,
        fileName: fileName,
        image: canvas.toDataURL('image/jpeg', 0.85)
      })
    });
    const data = await res.json();
    if(data && data.status === 'success'){
      showToast('☁️ สำรองรูปลง Google Drive แล้ว');
    } else {
      console.error('อัปโหลด Drive ไม่สำเร็จ:', data);
      showToast('⚠️ สำรองรูปลง Drive ไม่สำเร็จ (ดูรายละเอียดใน Console)');
    }
  }catch(err){
    console.error('อัปโหลด Drive error:', err);
    showToast('⚠️ ส่งรูปไปแล้วแต่ยืนยันผลไม่ได้ ลองเช็กใน Drive หรือดู Console');
  }
}


function downloadImage(cid, iid, def){
  recordDownload();
  const c = document.getElementById(cid);
  const v = (document.getElementById(iid)?.value || def).replace(/[^a-zA-Z0-9ก-๙]/g, '_');


  // 1. ดาวน์โหลดลงเครื่องผู้ใช้ทันที (ไฟล์ PNG ความคมชัดสูงสุด)
  const a = document.createElement('a');
  a.download = `${def}_${v}.png`;
  a.href = c.toDataURL('image/png', 1.0);
  a.click();


  // 2. สำรองลง Google Drive เฉพาะเมื่อผู้ใช้ไม่ได้ติ๊กช่องสำรองออก
  if(!isBackupOn()) return;


  const targetFolder = (def === 'รายงาน_ตู้') ? 'Vending_เติมตู้' : 'Vending_รูปทั่วไป';


  // ตั้งชื่อไฟล์ วันที่_เวลา_ชื่อสาขา_สุ่มรหัส (ใช้เวลาท้องถิ่น ไม่ใช่ UTC)
  const now = new Date();
  const dateStr = now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2,'0') + '-' + String(now.getDate()).padStart(2,'0');
  const timeStr = String(now.getHours()).padStart(2, '0') + '-' + String(now.getMinutes()).padStart(2, '0');
  const randCode = Math.random().toString(36).substring(2, 6);
  const driveFileName = `${dateStr}_${timeStr}_${v}_${randCode}.jpg`;


  backupToDrive(c, targetFolder, driveFileName);
}


