// ----- Toast (ข้อความแจ้งสถานะเล็ก ๆ ด้านล่างจอ) -----
let toastTimer = null;
function showToast(msg, ms = 4000){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), ms);
}


