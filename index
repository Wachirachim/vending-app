function generatePdf(){
  if(pdfLoading) return alert('กำลังโหลดรูปอยู่ รอสักครู่แล้วกดอีกครั้งครับ');
  if(!pdfImgs.length) return alert('กรุณาเลือกรูปภาพก่อนครับ');
  recordDownload();
  const doc = new jspdf.jsPDF({orientation:document.getElementById('pdfOrientation').value,unit:'mm',format:'a4'});
  const pw = doc.internal.pageSize.getWidth(), ph = doc.internal.pageSize.getHeight(), mw = pw-20, mh = ph-20;
  pdfImgs.forEach((img,idx)=>{
    if(idx>0) doc.addPage();
    let w = mw, h = mw/(img.width/img.height);
    if(h>mh){ h = mh; w = mh*(img.width/img.height); }
    const c = document.createElement('canvas');
    c.width = img.width; c.height = img.height;
    c.getContext('2d').drawImage(img,0,0);
    doc.addImage(c.toDataURL('image/jpeg',0.92),'JPEG',(pw-w)/2,(ph-h)/2,w,h);
  });
  doc.save('เอกสาร.pdf');
}
