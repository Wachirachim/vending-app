function getSavedNames(){
  let names = [];
  try {
    names = JSON.parse(localStorage.getItem('vending_recent_names') || '[]');
  } catch(e){ names = []; }


  const scheduleData = getStoredSchedule();
  Object.values(scheduleData).forEach(item => {
    [...(item.v8||[]), ...(item.v9||[])].forEach(n => {
      const trimmed = (n || '').trim();
      if(trimmed && !names.includes(trimmed)) names.push(trimmed);
    });
  });
  return names;
}


function saveNewName(name){
  const trimmed = (name || '').trim();
  if(!trimmed) return;
  let names = getSavedNames();
  if(!names.includes(trimmed)){
    names.push(trimmed);
    try {
      localStorage.setItem('vending_recent_names', JSON.stringify(names));
    } catch(e){}
  }
}


