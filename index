function saveDayDetails(){
  if(!isEditMode || !activeModalKey) return;
  const scheduleData = getStoredSchedule();


  const v8 = [
    document.getElementById('inp_v8_1').value.trim(),
    document.getElementById('inp_v8_2').value.trim(),
    document.getElementById('inp_v8_3').value.trim()
  ];
  const v9 = [
    document.getElementById('inp_v9_1').value.trim(),
    document.getElementById('inp_v9_2').value.trim(),
    document.getElementById('inp_v9_3').value.trim()
  ];


