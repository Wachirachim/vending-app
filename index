function fillQuickName(name){
  if(!isEditMode) return;
  const inputList = ['inp_v8_1','inp_v8_2','inp_v8_3','inp_v9_1','inp_v9_2','inp_v9_3'];


  if(lastFocusedInput && inputList.includes(lastFocusedInput.id)){
    lastFocusedInput.value = name;
    const currIdx = inputList.indexOf(lastFocusedInput.id);
    if(currIdx < inputList.length - 1){
      const nextInput = document.getElementById(inputList[currIdx + 1]);
      handleInputFocus(nextInput);
    }
    return;
  }


  for(let id of inputList){
    const inp = document.getElementById(id);
    if(!inp.value.trim()){
      inp.value = name;
      handleInputFocus(inp);
      return;
    }
  }
}


const thaiMonths = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
const thaiDays = ['อา','จ','อ','พ','พฤ','ศ','ส'];


function changeMonth(delta){
  currentCalMonth += delta;
  if(currentCalMonth < 0){ currentCalMonth = 11; currentCalYear--; }
  else if(currentCalMonth > 11){ currentCalMonth = 0; currentCalYear++; }
  renderCalendar();
}


function renderCalendar(){
  document.getElementById('calMonthTitle').innerText = `${thaiMonths[currentCalMonth]} ${currentCalYear + 543}`;
  const grid = document.getElementById('calGrid');
  grid.innerHTML = '';


  thaiDays.forEach(d => {
    const el = document.createElement('div');
    el.className = 'cal-day-head';
    el.innerText = d;
    grid.appendChild(el);
  });


  const firstDay = new Date(currentCalYear, currentCalMonth, 1).getDay();
  const totalDays = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
  const today = new Date();
  const scheduleData = getStoredSchedule();


  for(let i=0; i<firstDay; i++){
    const el = document.createElement('div');
    el.className = 'cal-cell empty';
    grid.appendChild(el);
  }


  for(let day=1; day<=totalDays; day++){
    const key = `${currentCalYear}-${String(currentCalMonth+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
    const dayData = scheduleData[key] || { v8:['','',''], v9:['','',''] };
    const filledV8 = (dayData.v8 || []).filter(Boolean).length;
    const filledV9 = (dayData.v9 || []).filter(Boolean).length;


    const cell = document.createElement('div');
    cell.className = 'cal-cell';
    if(today.getFullYear()===currentCalYear && today.getMonth()===currentCalMonth && today.getDate()===day){
      cell.classList.add('today');
    }


    const numSpan = document.createElement('div');
    numSpan.className = 'cal-cell-num';
    numSpan.innerText = day;
    cell.appendChild(numSpan);


    if(filledV8 > 0 || filledV9 > 0){
      const dotsWrap = document.createElement('div');
      dotsWrap.className = 'dots-row';
      for(let k=0; k<filledV8; k++){
        const dot = document.createElement('span');
        dot.className = 'dot';
        dot.style.background = '#f97316';
        dotsWrap.appendChild(dot);
      }
      for(let k=0; k<filledV9; k++){
        const dot = document.createElement('span');
        dot.className = 'dot';
        dot.style.background = '#22c55e';
        dotsWrap.appendChild(dot);
      }
      cell.appendChild(dotsWrap);
    }


    cell.onclick = () => openDayModal(key, day);
    grid.appendChild(cell);
  }


  renderMonthlyStats();
}


