async function generateMultiGridImage(){
  if(multiLoading) return alert('กำลังโหลดรูปอยู่ รอสักครู่แล้วกดอีกครั้งครับ');
  const N = multiImages.length;
  if(N === 0) return alert('กรุณาเลือกรูปภาพอย่างน้อย 1 รูปครับ');
  await ensureFonts();
  const [cW, cH] = getCanvasDims(currentRatioMulti);
  const c = document.getElementById('canvasMulti'), ctx = c.getContext('2d');
  c.width = cW; c.height = cH;
  ctx.fillStyle = currentMultiBg;
  ctx.fillRect(0,0,cW,cH);


  let cols = 1, rows = 1;
  if (N === 1) { cols = 1; rows = 1; }
  else if (N === 2) {
    cols = (currentRatioMulti === '3:4') ? 1 : 2;
    rows = (currentRatioMulti === '3:4') ? 2 : 1;
  }
  else if (N <= 4) { cols = 2; rows = 2; }
  else if (N <= 6) { cols = 3; rows = 2; }
  else if (N <= 9) { cols = 3; rows = 3; }
  else {
    cols = Math.ceil(Math.sqrt(N));
    rows = Math.ceil(N / cols);
  }


  const m = 14, g = 10;
  const cellW = (cW - (m * 2) - (g * (cols - 1))) / cols;
  const cellH = (cH - (m * 2) - (g * (rows - 1))) / rows;
  const filt = getFilterCss(currentFilterMulti);


  for(let i = 0; i < N; i++){
    const colIdx = i % cols;
    const rowIdx = Math.floor(i / cols);
    const x = m + (colIdx * (cellW + g));
    const y = m + (rowIdx * (cellH + g));
    ctx.save();
    if(filt !== 'none') ctx.filter = filt;
    drawImageFit(ctx, multiImages[i], x, y, cellW, cellH, currentFitMulti);
    ctx.restore();
  }


  const pos = document.getElementById('selTextPos').value;
  const t1 = document.getElementById('txtMulti_1').value.trim();
  const t2 = document.getElementById('txtMulti_2').value.trim();
  drawTextOverlay(ctx, cW, cH, t1, t2, pos);


  document.getElementById('resultCardMulti').style.display = 'block';
  document.getElementById('resultCardMulti').scrollIntoView({behavior:'smooth'});
}


function drawTextOverlay(ctx, cW, cH, t1, t2, pos){
  if(pos === 'none' || (!t1 && !t2)) return;
  ctx.save();
  ctx.textAlign = 'center';
  ctx.lineWidth = 14;
  ctx.lineJoin = 'round';
  ctx.strokeStyle = '#000';
  ctx.fillStyle = '#fff';


  const scale = Math.min(cW, cH) / 1200;
  const f1Size = Math.round(74 * scale);
  const f2Size = Math.round(70 * scale);
  const gap = Math.round(46 * scale);


  if(pos === 'center'){
    ctx.textBaseline = 'middle';
    ctx.font = `bold ${f1Size}px "Prompt", sans-serif`;
    if(t1 && t2){
      ctx.strokeText(t1, cW/2, cH/2 - gap); ctx.fillText(t1, cW/2, cH/2 - gap);
      ctx.font = `bold ${f2Size}px "Prompt", sans-serif`;
      ctx.strokeText(t2, cW/2, cH/2 + gap); ctx.fillText(t2, cW/2, cH/2 + gap);
    } else {
      const s = t1 || t2;
      ctx.strokeText(s, cW/2, cH/2); ctx.fillText(s, cW/2, cH/2);
    }
  } else if(pos === 'topbottom'){
    const fTopSize = Math.round(64 * scale);
    ctx.textBaseline = 'top';
    ctx.font = `bold ${fTopSize}px "Prompt", sans-serif`;
    if(t1){ ctx.strokeText(t1, cW/2, 35 * scale); ctx.fillText(t1, cW/2, 35 * scale); }
    ctx.textBaseline = 'bottom';
    ctx.font = `bold ${fTopSize}px "Prompt", sans-serif`;
    if(t2){ ctx.strokeText(t2, cW/2, cH - (35 * scale)); ctx.fillText(t2, cW/2, cH - (35 * scale)); }
  }
  ctx.restore();
}


